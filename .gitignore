# Dependencies
node_modules/

# Envio build output
.envio/
generated/

# Envio ships its own Claude skills into the project via `envio skills update`.
# They are their docs, not ours, and they regenerate on demand. The leading **/
# matters: a pattern with only a middle slash anchors to the repo root and would
# miss indexer/.claude/skills/.
**/.claude/skills/

# Submission and form-fill material carries personal data and never ships
/submit/

# Local environment
.env
.env.*
!.env.example

# Render outputs live with the lane, not in the repo
DEMO-*.mp4
upload-*/

# OS
.DS_Store

# Foundry build output and the local verified-source backup
contracts/out/
contracts/cache/
contracts/broadcast/
contracts/.Aqueous.verified.bak

# forge-std is a dependency, not our code. `forge install` restores it, and keeping it out
# avoids vendoring someone else's licence into a SAND-1.0 repo. See contracts/README.md.
contracts/lib/

# Next.js
/.next/
/out/
next-env.d.ts

# TypeScript's incremental build cache. Machine-local, rewritten by every build, and 300 KB of
# churn in a diff that is supposed to be readable. `npm run typecheck` regenerates it.
tsconfig.tsbuildinfo

# The x402 signing helper is a local tool that touches the house key at runtime. It is not part
# of the product and it never ships.
/x402sign.mjs

# Generated exports. tools/export-d1.py writes a full copy of the measurement
# database here, which is 19 MB of SQL and is rebuilt on demand.
/build/

# Build-journey and announce pages. Publishing material, kept local, never in the public repo.
CONTENT-*.html

# Intermediate backdrops from scripts/build-assets.py. The composited cards in public/ are
# the artefact; these are the raw generations and are reproducible from the script.
.asset-tmp/

# Python bytecode from the scripts/ helpers. Regenerated on every run, never source.
__pycache__/
*.pyc
